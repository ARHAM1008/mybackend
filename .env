# Database
DATABASE_URL=postgresql://neondb_owner:npg_Yo7XBECKt0in@ep-sparkling-shadow-ax37rv0u-pooler.c-4.us-east-2.aws.neon.tech/codementordb?sslmode=require&channel_binding=require
# For production (Supabase PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# CORS
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Compiler
# Set to "local" (default) to run code directly on the server.
# Set to "piston" to use the public Piston API (whitelist-only as of 2/15/2026).
COMPILER_PROVIDER=local

# App
ENVIRONMENT=development
APP_NAME=CodeMentor
